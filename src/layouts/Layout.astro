---
import '../styles/global.css';

interface Props {
	title?: string;
	description?: string;
}

const {
	title = 'РЛУС «Десна»',
	description = 'Офіційний сайт Ради Лідерів учнівського самоврядування Деснянського району міста Києва'
} = Astro.props;
---

<!doctype html>
<html lang="uk">
	<head>
		<meta charset="UTF-8" />
		<meta name="viewport" content="width=device-width, initial-scale=1" />

		<meta name="description" content={description} />

		<title>{title}</title>
	</head>

	<body>
		<slot />
	</body>
</html>