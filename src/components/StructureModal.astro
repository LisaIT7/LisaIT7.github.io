<script>
	const modal =
		document.querySelector<HTMLDialogElement>('#structureModal');

	const modalContent =
		modal?.querySelector<HTMLElement>('[data-modal-content]');

	const closeButton =
		modal?.querySelector<HTMLButtonElement>('[data-modal-close]');

	const openButtons =
		document.querySelectorAll<HTMLButtonElement>(
			'[data-structure-modal]'
		);

	function prepareImages(root: HTMLElement) {
		const images =
			root.querySelectorAll<HTMLImageElement>(
				'[data-modal-image]'
			);

		images.forEach((image) => {
			const wrapper =
				image.closest<HTMLElement>(
					'.profile__photo, .director-card__photo, .team-modal__photo'
				);

			const markMissing = () => {
				wrapper?.classList.add('is-missing');
			};

			image.addEventListener(
				'error',
				markMissing,
				{ once: true }
			);

			if (
				image.complete &&
				image.naturalWidth === 0
			) {
				markMissing();
			}
		});
	}

	function closeModal() {
	if (!modal?.open) {
		return;
	}

	modal.classList.remove('is-open');

	window.setTimeout(() => {
		modal.close();

		document.body.classList.remove(
			'structure-modal-open'
		);
	}, 300);
}

	openButtons.forEach((button) => {
		button.addEventListener('click', () => {
			const key =
				button.dataset.structureModal;

			if (
				!key ||
				!modal ||
				!modalContent
			) {
				return;
			}

			const template =
				document.querySelector<HTMLTemplateElement>(
					`template[data-structure-template="${key}"]`
				);

			if (!template) {
				return;
			}

			modalContent.replaceChildren(
				template.content.cloneNode(true)
			);

			prepareImages(modalContent);

			modal.showModal();

requestAnimationFrame(() => {
	modal.classList.add('is-open');
});

document.body.classList.add(
	'structure-modal-open'
);
		});
	});

	closeButton?.addEventListener(
		'click',
		closeModal
	);

	modal?.addEventListener(
		'click',
		(event: MouseEvent) => {
			if (event.target === modal) {
				closeModal();
			}
		}
	);

	modal?.addEventListener(
		'close',
		() => {
			document.body.classList.remove(
				'structure-modal-open'
			);
		}
	);
</script>


