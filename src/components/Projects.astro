---

<section class="projects" id="projects">
	<div class="projects__inner">

		<header class="projects__header">
			<div class="projects__heading">
				<p class="projects__label">Ініціативи та події</p>

				<h2>
					Наші
					<span>проєкти</span>
				</h2>
			</div>

			<p class="projects__intro">
				Ініціативи, події та традиції, які об’єднують лідерів
				учнівського самоврядування Деснянського району.
			</p>
		</header>

		<div class="projects__grid">
			{
				projects.map((project, index) => (
					<article class="project-card">

						<div class="project-card__media">
							{
								project.image ? (
									<img
										src={project.image}
										alt={project.imageAlt}
										loading="lazy"
									/>
								) : (
									<div class="project-card__placeholder">
										<div class="project-card__placeholder-mark">
	                            <span>{String(index + 1).padStart(2, '0')}</span>
                                    </div>

										<p>Фото проєкту</p>
									</div>
								)
							}

							<div class="project-card__media-top">
								<span class="project-card__category">
									{project.category}
								</span>

								<span class="project-card__number">
									{String(index + 1).padStart(2, '0')}
								</span>
							</div>
						</div>

						<div class="project-card__body">

							<div class="project-card__meta">
								<time>{project.date}</time>
							</div>

							<h3>{project.title}</h3>

							{
							project.keyFact && (
							<p class="project-card__highlight">
							<span class="project-card__highlight-mark"></span>
							{project.keyFact}
							</p>
							)
							}

							<div class="project-card__footer">
	<button
		class="project-card__more"
		type="button"
		data-project-open={project.id}
		aria-controls="project-modal"
		aria-haspopup="dialog"
	>
		<span>Детальніше</span>

		<svg
			viewBox="0 0 24 24"
			aria-hidden="true"
		>
			<path d="M5 12h13M13 6l6 6-6 6" />
		</svg>
	</button>
</div>

						</div>
					</article>
				))
			}
		</div>

	</div>
</section>

{
	projects.map((project) => (
		<template data-project-template={project.id}>
			<article class="project-modal__article">

				<div class="project-modal__heading">
					<div class="project-modal__meta">
						<span>{project.category}</span>
						<time>{project.date}</time>
					</div>

					<h2 id="project-modal-title">
						{project.title}
					</h2>
				</div>

				<div class="project-modal__layout">

					<div class="project-modal__information">

					<div class="project-modal__fact">
						<strong>{project.keyFact}</strong>
					</div>

						<div class="project-modal__description">
							{
								project.fullDescription.map((paragraph) => (
									<p>{paragraph}</p>
								))
							}
						</div>

						{
							project.partners.length > 0 && (
								<div class="project-modal__partners">
									<p class="project-modal__partners-label">
										Партнери
									</p>

									<div class="project-modal__partners-list">
										{
											project.partners.map((partner) =>
												partner.href ? (
													<a
														href={partner.href}
														target="_blank"
														rel="noopener noreferrer"
													>
														{partner.name}
														<span aria-hidden="true">↗</span>
													</a>
												) : (
													<span>
														{partner.name}
													</span>
												)
											)
										}
									</div>
								</div>
							)
						}

					</div>

					<div class="project-modal__gallery">
						{
							project.gallery.map((image, index) => (
								<div
									class:list={[
										'project-modal__photo',
										index === 0 && 'project-modal__photo--wide',
									]}
								>
									<img
										src={image}
										alt={`${project.title} — фото ${index + 2}`}
										loading="lazy"
									/>
								</div>
							))
						}
					</div>

				</div>

			</article>
		</template>
	))
}

<div
	class="project-modal"
	id="project-modal"
	data-project-modal
	hidden
>
	<div
		class="project-modal__backdrop"
		data-project-close
	></div>

	<div
		class="project-modal__window"
		role="dialog"
