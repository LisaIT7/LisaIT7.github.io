<script>
	const modal =
		document.querySelector<HTMLElement>('[data-project-modal]');

	const modalContent =
		document.querySelector<HTMLElement>('[data-project-content]');

	const openButtons =
		document.querySelectorAll<HTMLButtonElement>('[data-project-open]');

	const closeButtons =
		document.querySelectorAll<HTMLButtonElement | HTMLElement>(
			'[data-project-close]'
		);

	let activeTrigger: HTMLButtonElement | null = null;
	let closeTimer: number | undefined;

	function openProject(projectId: string, trigger: HTMLButtonElement) {
		if (!modal || !modalContent) return;

		const template =
			document.querySelector<HTMLTemplateElement>(
				`template[data-project-template="${projectId}"]`
			);

		if (!template) return;

		if (closeTimer) {
			window.clearTimeout(closeTimer);
		}

		modalContent.replaceChildren(
			template.content.cloneNode(true)
		);

		activeTrigger = trigger;

		modal.hidden = false;

		document.documentElement.classList.add(
			'project-modal-open'
		);

		document.body.classList.add(
			'project-modal-open'
		);

		requestAnimationFrame(() => {
			modal.classList.add('is-open');

			const closeButton =
				modal.querySelector<HTMLButtonElement>(
					'.project-modal__close'
				);

			closeButton?.focus();
		});
	}

	function closeProject() {
		if (!modal || !modalContent) return;

		modal.classList.remove('is-open');

		document.documentElement.classList.remove(
			'project-modal-open'
		);

		document.body.classList.remove(
			'project-modal-open'
		);

		closeTimer = window.setTimeout(() => {
			modal.hidden = true;

			modalContent.replaceChildren();

			activeTrigger?.focus();
			activeTrigger = null;
		}, 220);
	}

	openButtons.forEach((button) => {
		button.addEventListener('click', () => {
			const projectId = button.dataset.projectOpen;

			if (!projectId) return;

			openProject(projectId, button);
		});
	});

	closeButtons.forEach((button) => {
		button.addEventListener('click', closeProject);
	});

	document.addEventListener('keydown', (event) => {
		if (
			event.key === 'Escape' &&
			modal &&
			!modal.hidden
		) {
			closeProject();
		}
	});
</script>