<header class="header">
	<div class="header__inner">

		<a class="brand" href="/" aria-label="РЛУС «Десна» — головна">
			<img
				class="brand__logo"
				src="/images/desna-logo.png"
				alt="Логотип РЛУС «Десна»"
			/>

			<div class="brand__text">
				<strong>РЛУС</strong>
				<span>«Десна»</span>
			</div>
		</a>


		<button
			class="menu-button"
			type="button"
			aria-label="Відкрити меню"
			aria-expanded="false"
			aria-controls="main-navigation"
			data-menu-button
		>
			<span></span>
			<span></span>
		</button>


		<nav
			class="nav"
			id="main-navigation"
			aria-label="Головна навігація"
			data-navigation
		>
			<a class="news-link" href="/news">Новини</a>

			<a href="/#about">Про нас</a>
			<a href="/#team">Команда</a>
			<a href="/#sectors">Сектори</a>
			<a href="/#projects">Проєкти</a>
			<a href="/#cooperation">Співпраця</a>
			<a href="/#contacts">Контакти</a>
		</nav>

	</div>
</header>


<style>
	.header {
		position: sticky;
		top: 0;
		z-index: 100;

		background: rgba(255, 255, 255, 0.96);
		backdrop-filter: blur(14px);

		border-bottom: 1px solid var(--color-border);
	}

	.header__inner {
		position: relative;

		width: min(calc(100% - 48px), var(--container));
		height: 84px;

		margin: 0 auto;

		display: flex;
		align-items: center;
		justify-content: space-between;

		gap: 48px;
	}


	/* =========================
	   BRAND
	   ========================= */

	.brand {
		display: flex;
		align-items: center;

		gap: 4px;

		flex-shrink: 0;

		color: inherit;
		text-decoration: none;
	}

	.brand__logo {
		width: 82px;
		height: auto;

		display: block;

		flex-shrink: 0;

		margin-right: -6px;
	}

	.brand__text {
		display: flex;
		flex-direction: row;
		align-items: baseline;

		gap: 6px;

		line-height: 1;
		white-space: nowrap;
	}

	.brand__text strong {
		color: var(--color-blue);

		font-size: 18px;
		font-weight: 700;
	}

	.brand__text span {
		margin-top: 0;

		color: var(--color-navy);

		font-size: 18px;
		font-weight: 700;
	}


	/* =========================
	   DESKTOP NAVIGATION
	   ========================= */

	.nav {
		display: flex;
		align-items: center;

		gap: 30px;

		font-size: 15px;
		font-weight: 600;

		color: #343a46;
	}

	.nav a {
		position: relative;

		padding: 8px 0;

		color: inherit;
		text-decoration: none;

		transition: color 180ms ease;
	}

	.nav a::after {
		content: '';

		position: absolute;

		left: 0;
		bottom: 2px;

		width: 100%;
		height: 2px;

		background: var(--color-yellow);

		transform: scaleX(0);
		transform-origin: left;

		transition: transform 180ms ease;
	}

	.nav a:hover {
		color: var(--color-blue);
	}

	.nav a:hover::after {
		transform: scaleX(1);
	}


	/* NEWS */

	.news-link {
		display: inline-flex;
		align-items: center;

		gap: 8px;

		margin-right: 10px;

		color: var(--color-blue) !important;
		font-weight: 700;
	}

	.news-link::before {
		content: '';

		width: 6px;
		height: 6px;

		flex: 0 0 auto;

		border-radius: 50%;
		background: var(--color-blue);
	}

	.nav .news-link::after {
		background: var(--color-blue);
	}


	/* =========================
	   BURGER
	   ========================= */

	.menu-button {
		display: none;

		position: relative;

		width: 46px;
		height: 46px;

		padding: 0;

		border: 1px solid rgba(13, 22, 38, 0.12);
		border-radius: 50%;

		background: transparent;

		cursor: pointer;

		flex-shrink: 0;
	}

	.menu-button span {
		position: absolute;

		left: 50%;

		width: 18px;
		height: 1.5px;

		background: var(--color-navy);

		transform: translateX(-50%);

		transition:
			transform 220ms ease,
			top 220ms ease;
	}

	.menu-button span:first-child {
		top: 18px;
	}

	.menu-button span:last-child {
		top: 26px;
	}

	.menu-button.is-open span:first-child {
		top: 22px;

		transform:
			translateX(-50%)
			rotate(45deg);
	}

	.menu-button.is-open span:last-child {
		top: 22px;

		transform:
			translateX(-50%)
			rotate(-45deg);
	}


	/* =========================
	   MOBILE
	   ========================= */

	@media (max-width: 950px) {

		.news-link {
	justify-content: flex-start !important;
	gap: 10px;
}

		.header__inner {
			width: min(calc(100% - 32px), var(--container));
			height: 88px;

			gap: 20px;
		}

		.brand__logo {
			width: 68px;

			margin-right: -3px;
		}

		.brand__text {
			gap: 5px;
		}

		.brand__text strong,
		.brand__text span {
			font-size: 17px;
		}


		/* BURGER VISIBLE */

		.menu-button {
			display: block;
		}


		/* DROPDOWN */

		.nav {
			position: absolute;

			top: 100%;
			left: -16px;
			right: -16px;

			display: flex;
			flex-direction: column;
			align-items: stretch;

			gap: 0;

			padding:
				14px
				32px
				26px;

			background: #ffffff;

			border-top: 1px solid var(--color-border);
			border-bottom: 1px solid var(--color-border);

			box-shadow:
				0 18px 45px rgba(13, 22, 38, 0.08);

			opacity: 0;
			visibility: hidden;

			transform: translateY(-10px);

			pointer-events: none;

			transition:
				opacity 220ms ease,
				transform 220ms ease,
				visibility 220ms ease;
		}

		.nav.is-open {
			opacity: 1;
			visibility: visible;

			transform: translateY(0);

			pointer-events: auto;
		}


		/* MOBILE LINKS */

		.nav a {
			display: flex;
			align-items: center;
			justify-content: space-between;

			width: 100%;

			padding: 17px 0;

			border-bottom: 1px solid rgba(13, 22, 38, 0.08);

			color: var(--color-navy);

			font-size: 18px;
			font-weight: 650;

			text-decoration: none;
		}

		.nav a:last-child {
			border-bottom: 0;
		}

		.nav a::after {
			display: none;
		}


		/* NEWS MOBILE */

		.news-link {
			margin-right: 0;

			color: var(--color-blue) !important;
		}

		.news-link::before {
			width: 7px;
			height: 7px;
		}
	}


	@media (max-width: 520px) {

		.header__inner {
			height: 84px;
		}

		.brand__logo {
			width: 62px;
		}

		.brand__text strong,
		.brand__text span {
			font-size: 16px;
		}

		.menu-button {
			width: 43px;
			height: 43px;
		}
	}
</style>


<script>
	const menuButton =
		document.querySelector<HTMLButtonElement>('[data-menu-button]');

	const navigation =
		document.querySelector<HTMLElement>('[data-navigation]');

	function closeMenu() {
		if (!menuButton || !navigation) return;

		menuButton.classList.remove('is-open');
		navigation.classList.remove('is-open');

		menuButton.setAttribute('aria-expanded', 'false');
		menuButton.setAttribute('aria-label', 'Відкрити меню');
	}

	menuButton?.addEventListener('click', () => {
		if (!navigation) return;

		const isOpen =
			navigation.classList.toggle('is-open');

		menuButton.classList.toggle('is-open', isOpen);

		menuButton.setAttribute(
			'aria-expanded',
			String(isOpen)
		);

		menuButton.setAttribute(
			'aria-label',
			isOpen
				? 'Закрити меню'
				: 'Відкрити меню'
		);
	});

	navigation
		?.querySelectorAll('a')
		.forEach((link) => {
			link.addEventListener('click', closeMenu);
		});

	document.addEventListener('keydown', (event) => {
		if (event.key === 'Escape') {
			closeMenu();
		}
	});
</script>