---
const contacts = {
	instagram: 'https://www.instagram.com/desnyansky?stkn=OHdqeHdlcWEzcmln',

	// Встав своє точне посилання на TikTok
	tiktok: 'https://www.tiktok.com/@desnyanskyy?_r=1&_t=ZS-99aHO4mpyuV',

    facebook: 'https://www.facebook.com/profile.php?id=100090439705823',

	email: 'rada.desnyansky@gmail.com',
};

const president = {
	role: 'Президент',
	name: 'Лігус Олексій',

	// Встав погоджені контакти
	email: 'ligus.oleksii@gmail.com',
	phone: '+380 99 274 72 95',
	phoneHref: 'tel:+380992747295',
};

const vicePresident = {
	role: 'Віцепрезидент',
	name: 'Юшко Вікторія',

	// Встав погоджені контакти
	email: 'victoria.ushko09@gmail.com',
	phone: '+380 66 499 64 67',
	phoneHref: 'tel:+380664996467',
};

const gmailLink = (email: string, subject: string) =>
	`https://mail.google.com/mail/?view=cm&fs=1&to=${encodeURIComponent(email)}&su=${encodeURIComponent(subject)}`;

// Встав сюди повне посилання на свій LinkedIn
const authorLinkedIn = 'https://www.linkedin.com/in/yelyzaveta-hilevych-173746406/';
---

<footer class="footer" id="contacts">
	<div class="footer__inner">

		<!-- HEADER -->
		<div class="footer__header">
			<div>
				<p class="footer__label">Контакти</p>

				<h2>
					Будьмо
					<span>на зв’язку</span>
				</h2>
			</div>

			<p class="footer__intro">
				Маєте ідею, пропозицію або хочете запропонувати співпрацю?
				Зв’яжіться з Радою або безпосередньо з представниками Президії.
			</p>
		</div>


		<!-- CONTACT CARDS -->
		<div class="footer__contact-grid">

			<!-- РЛУС -->
			<section class="contact-card contact-card--main">
				<div class="contact-card__top">
					<span class="contact-card__eyebrow">
						Офіційні контакти
					</span>

					<span class="contact-card__number">01</span>
				</div>

				<div class="contact-card__heading">
					<img
						src="/images/desna-logo.png"
						alt=""
						aria-hidden="true"
					/>

					<div>
						<h3>РЛУС «Десна»</h3>
						<p>Деснянський район міста Києва</p>
					</div>
				</div>

				<div class="contact-card__links">

					<a
						class="contact-link"
						href={contacts.instagram}
						target="_blank"
						rel="noopener noreferrer"
					>
						<span class="contact-link__icon" aria-hidden="true">
							<svg viewBox="0 0 24 24">
								<rect
									x="3"
									y="3"
									width="18"
									height="18"
									rx="5"
								/>
								<circle cx="12" cy="12" r="4" />
								<circle cx="17.5" cy="6.5" r="1" />
							</svg>
						</span>

						<span class="contact-link__text">
							<strong>Instagram</strong>
							<small>Офіційна сторінка</small>
						</span>

						<svg
	class="contact-link__arrow"
	viewBox="0 0 24 24"
	aria-hidden="true"
>
	<path d="M5 12h13" />
	<path d="M13 6l6 6-6 6" />
</svg>
					</a>


					{
						contacts.tiktok && (
							<a
								class="contact-link"
								href={contacts.tiktok}
								target="_blank"
								rel="noopener noreferrer"
							>
								<span
									class="contact-link__icon"
									aria-hidden="true"
								>
									<svg viewBox="0 0 24 24">
										<path d="M14 4v10.5a4.5 4.5 0 1 1-3.5-4.4" />
										<path d="M14 4c.7 2.2 2.2 3.6 4.5 4" />
									</svg>
								</span>

								<span class="contact-link__text">
									<strong>TikTok</strong>
									<small>Офіційна сторінка</small>
								</span>

								<svg
	class="contact-link__arrow"
	viewBox="0 0 24 24"
	aria-hidden="true"
>
	<path d="M5 12h13" />
	<path d="M13 6l6 6-6 6" />
</svg>
							</a>
						)
					}


{
	contacts.facebook && (
		<a
	class="contact-link"
	href={contacts.facebook}
	target="_blank"
	rel="noopener noreferrer"
>
	<span class="contact-link__icon contact-link__icon--facebook" aria-hidden="true">
		<svg viewBox="0 0 24 24" aria-hidden="true">
			<path d="M13.5 21v-7h2.3l.4-3h-2.7V9.2c0-.9.3-1.5 1.6-1.5H16V5.1c-.3 0-.9-.1-1.8-.1-2.3 0-3.8 1.4-3.8 4V11H8v3h2.4v7h3.1Z" />
		</svg>
	</span>

	<span class="contact-link__text">
		<strong>Facebook</strong>
		<small>Офіційна сторінка</small>
	</span>

	<svg
	class="contact-link__arrow"
	viewBox="0 0 24 24"
	aria-hidden="true"
>
	<path d="M5 12h13" />
	<path d="M13 6l6 6-6 6" />
</svg>
</a>
	)
}

					<a
						class="contact-link"
						href={gmailLink(
	contacts.email,
	'Звернення до РЛУС «Десна»'
)}
target="_blank"
rel="noopener noreferrer"
					>
						<span class="contact-link__icon" aria-hidden="true">
							<svg viewBox="0 0 24 24">
								<rect
									x="3"
									y="5"
									width="18"
									height="14"
									rx="2"
								/>
								<path d="M4 7l8 6 8-6" />
							</svg>
						</span>

						<span class="contact-link__text">
							<strong>Email</strong>
							<small>{contacts.email}</small>
						</span>

<svg
	class="contact-link__arrow"
	viewBox="0 0 24 24"
	aria-hidden="true"
>
	<path d="M5 12h13" />
	<path d="M13 6l6 6-6 6" />
</svg>
					</a>

				</div>
			</section>


			<!-- PRESIDENT -->
			<section class="contact-card contact-card--person">
				<div class="contact-card__top">
					<span class="contact-card__eyebrow">
						{president.role}
					</span>

					<span class="contact-card__number">02</span>
				</div>

				<div class="person-contact__main">
					<h3>{president.name}</h3>

					<p>
						Для організаційних питань, пропозицій
						та прямого зв’язку.
					</p>
				</div>

				<div class="person-contact__links">

					{
						president.email && (
							<a
	href={gmailLink(
		president.email,
		'Звернення до Президента РЛУС «Десна»'
	)}
	target="_blank"
	rel="noopener noreferrer"
>
								<span>
									Email
									<small>{president.email}</small>
								</span>

								<svg viewBox="0 0 24 24" aria-hidden="true">
									<path d="M5 12h13" />
									<path d="M13 6l6 6-6 6" />
								</svg>
							</a>
						)
					}

					{
						president.phone && president.phoneHref && (
							<a href={president.phoneHref}>
								<span>
									Телефон
									<small>{president.phone}</small>
								</span>

								<svg viewBox="0 0 24 24" aria-hidden="true">
									<path d="M5 12h13" />
									<path d="M13 6l6 6-6 6" />
								</svg>
							</a>
						)
					}

					{
						!president.email && !president.phone && (
							<p class="person-contact__pending">
								Контактні дані буде додано після погодження.
							</p>
						)
					}

				</div>
			</section>


			<!-- VICE PRESIDENT -->
			<section class="contact-card contact-card--person">
				<div class="contact-card__top">
					<span class="contact-card__eyebrow">
						{vicePresident.role}
					</span>

					<span class="contact-card__number">03</span>
				</div>

				<div class="person-contact__main">
					<h3>{vicePresident.name}</h3>

					<p>
						Для організаційних питань, пропозицій
						та прямого зв’язку.
					</p>
				</div>

				<div class="person-contact__links">

					{
						vicePresident.email && (
							<a
	href={gmailLink(
		vicePresident.email,
		'Звернення до Віцепрезидента РЛУС «Десна»'
	)}
	target="_blank"
	rel="noopener noreferrer"
>
								<span>
									Email
									<small>{vicePresident.email}</small>
								</span>

								<svg viewBox="0 0 24 24" aria-hidden="true">
									<path d="M5 12h13" />
									<path d="M13 6l6 6-6 6" />
								</svg>
							</a>
						)
					}

					{
						vicePresident.phone && vicePresident.phoneHref && (
							<a href={vicePresident.phoneHref}>
								<span>
									Телефон
									<small>{vicePresident.phone}</small>
								</span>

								<svg viewBox="0 0 24 24" aria-hidden="true">
									<path d="M5 12h13" />
									<path d="M13 6l6 6-6 6" />
								</svg>
							</a>
						)
					}

					{
						!vicePresident.email && !vicePresident.phone && (
							<p class="person-contact__pending">
								Контактні дані буде додано після погодження.
							</p>
						)
					}

				</div>
			</section>

		</div>


		<!-- FOOTER NAV -->
		<div class="footer__bottom">

			<a
				class="footer__brand"
				href="/"
				aria-label="РЛУС «Десна» — на головну"
			>
				<img
					src="/images/desna-logo.png"
					alt="Логотип РЛУС «Десна»"
				/>

				<div>
					<strong>РЛУС</strong>
					<span>«Десна»</span>
				</div>
			</a>

			<nav class="footer__nav" aria-label="Навігація у футері">
				<a href="/#about">Про нас</a>
				<a href="/#structure">Команда</a>
				<a href="/#sectors">Сектори</a>
				<a href="/#projects">Проєкти</a>
				<a href="/#cooperation">Співпраця</a>
			</nav>

		</div>


		<!-- COPYRIGHT -->
		<div class="footer__legal">

			<p>© 2026 РЛУС «Десна»</p>

			<p>
				Розробка сайту— 

				{
					authorLinkedIn ? (
						<a
							class="footer__author"
							href={authorLinkedIn}
							target="_blank"
							rel="noopener noreferrer"
						>
							 Yelyzaveta Hilevych
						</a>
					) : (
						<strong> Yelyzaveta Hilevych</strong>
					)
				}
			</p>

		</div>

	</div>
</footer>


<style>
	.footer {
		position: relative;
		padding: 82px 0 28px;

		background: #0d1626;
		color: #ffffff;

		overflow: hidden;
	}

	.footer::before {
		content: '';
		position: absolute;

		width: 720px;
		height: 720px;

		top: -330px;
		right: -230px;

		border-radius: 50%;

		background: rgba(36, 87, 230, 0.14);
		filter: blur(110px);

		pointer-events: none;
	}

	.footer__inner {
		position: relative;
		z-index: 1;

		width: min(calc(100% - 48px), var(--container));
		margin: 0 auto;
	}


	/* ==================================================
	   HEADER
	   ================================================== */

	.footer__header {
		display: grid;
		grid-template-columns: 1.05fr 0.75fr;
		gap: 90px;
		align-items: end;

		margin-bottom: 52px;
	}

	.footer__label {
		margin: 0 0 12px;

		color: var(--color-yellow);

		font-size: 13px;
		font-weight: 700;
		line-height: 1;

		letter-spacing: 0.13em;
		text-transform: uppercase;
	}

	.footer__header h2 {
		margin: 0;

		color: #ffffff;

		font-size: clamp(56px, 5vw, 88px);
		font-weight: 620;
		line-height: 0.94;
		letter-spacing: -0.055em;
	}

	.footer__header h2 span {
		display: block;

		margin-top: 7px;

		color: #8faeff;

		font-weight: 400;
		font-style: italic;
	}

	.footer__intro {
		max-width: 520px;
		margin: 0 0 7px auto;

		color: rgba(255, 255, 255, 0.62);

		font-size: 17px;
		line-height: 1.7;
	}


	/* ==================================================
	   CONTACT GRID
	   ================================================== */

	.footer__contact-grid {
	display: grid;
	grid-template-columns: 1.25fr 1fr 1fr;
	gap: 18px;
	align-items: stretch;
}

	.contact-card {
		position: relative;

		display: flex;
		flex-direction: column;

		padding: 24px;

		border:
			1px solid rgba(255, 255, 255, 0.12);

		border-radius: 24px;

		background:
			linear-gradient(
				145deg,
				rgba(255, 255, 255, 0.065),
				rgba(255, 255, 255, 0.025)
			);

		overflow: hidden;

		transition:
			transform 220ms ease,
			border-color 220ms ease,
			background 220ms ease;
	}

	.contact-card:hover {
		transform: translateY(-4px);

		border-color:
			rgba(255, 255, 255, 0.21);

		background:
			linear-gradient(
				145deg,
				rgba(255, 255, 255, 0.085),
				rgba(255, 255, 255, 0.035)
			);
	}

	.contact-card__top {
		display: flex;
		align-items: center;
		justify-content: space-between;
		gap: 20px;

		margin-bottom: 30px;
	}

	.contact-card__eyebrow {
		color: var(--color-yellow);

		font-size: 11px;
		font-weight: 700;

		letter-spacing: 0.12em;
		text-transform: uppercase;
	}

	.contact-card__number {
		color:
			rgba(255, 255, 255, 0.26);

		font-size: 11px;
		font-weight: 700;

		letter-spacing: 0.1em;
	}


	/* ==================================================
	   OFFICIAL CONTACT CARD
	   ================================================== */

	.contact-card__heading {
		display: flex;
		align-items: center;
		gap: 15px;

		margin-bottom: 28px;
	}

	.contact-card__heading img {
		flex: 0 0 auto;

		width: 48px;
		height: 48px;

		object-fit: contain;
	}

	.contact-card__heading h3 {
		margin: 0;

		color: #ffffff;

		font-size: 25px;
		font-weight: 650;

		letter-spacing: -0.025em;
	}

	.contact-card__heading p {
		margin: 5px 0 0;

		color:
			rgba(255, 255, 255, 0.46);

		font-size: 12px;
		line-height: 1.4;
	}

	.contact-card__links {
	display: grid;
	grid-template-columns: repeat(2, minmax(0, 1fr));

	margin-top: 8px;

	border-top: 1px solid rgba(255, 255, 255, 0.1);
}

	.contact-link {
		display: grid;

		grid-template-columns:
			auto
			1fr
			auto;

		align-items: center;
		gap: 15px;

		min-width: 0;
		padding: 12px 14px;

		border-bottom:
			1px solid rgba(255, 255, 255, 0.1);

		color: #ffffff;
		text-decoration: none;
	}

	.contact-link:last-child {
		border-bottom: 0;
	}

	.contact-link__icon {
		display: grid;
		place-items: center;

		width: 38px;
		height: 38px;

		border:
			1px solid rgba(255, 255, 255, 0.13);

		border-radius: 50%;

		color: var(--color-yellow);

		transition:
			background 180ms ease,
			transform 180ms ease;
	}

	.contact-link:hover .contact-link__icon {
		background:
			rgba(255, 255, 255, 0.07);

		transform: scale(1.04);
	}

	.contact-link__icon svg {
		width: 18px;
		height: 18px;

		fill: none;
		stroke: currentColor;

		stroke-width: 1.7;
		stroke-linecap: round;
		stroke-linejoin: round;
	}

	.contact-link__text {
		display: block;
		min-width: 0;
	}

	.contact-link__text strong {
		display: block;

		color: #ffffff;

		font-size: 15px;
		font-weight: 600;
	}

	.contact-link__text small {
		display: block;

		margin-top: 3px;

		overflow: hidden;
		text-overflow: ellipsis;

		color:
			rgba(255, 255, 255, 0.43);

		font-size: 11px;
		white-space: nowrap;
	}

	.contact-link__arrow {
		width: 18px;
		height: 18px;

		fill: none;

		stroke: var(--color-yellow);
		stroke-width: 1.7;

		stroke-linecap: round;
		stroke-linejoin: round;

		transition:
			transform 180ms ease;
	}

	.contact-link:hover .contact-link__arrow {
		transform: translate(4px, -2px);
	}

    .contact-link__icon svg {
	width: 22px;
	height: 22px;
}

.contact-link__icon:not(.contact-link__icon--facebook) svg {
	fill: none;
	stroke: currentColor;
	stroke-width: 1.8;
	stroke-linecap: round;
	stroke-linejoin: round;
}

.contact-link__icon--facebook svg {
	fill: currentColor;
}

.contact-link:nth-child(odd) {
	padding-left: 0;
	border-right: 1px solid rgba(255, 255, 255, 0.1);
}

.contact-link:nth-child(even) {
	padding-right: 0;
	padding-left: 18px;
}

.contact-link:nth-last-child(-n + 2) {
	border-bottom: 0;
}


	/* ==================================================
	   PRESIDENT / VICE PRESIDENT
	   ================================================== */

	.person-contact__main {
		margin-bottom: 18px;
	}

	.person-contact__main h3 {
		margin: 0;

		color: #ffffff;

		font-size: clamp(24px, 1.75vw, 31px);
		font-weight: 620;
		line-height: 1.08;

		letter-spacing: -0.035em;
	}

	.person-contact__main p {
		max-width: 300px;

		margin: 15px 0 0;

		color:
			rgba(255, 255, 255, 0.48);

		font-size: 13px;
		line-height: 1.55;
	}

	.person-contact__links {
	margin-top: 0;

	border-top: 1px solid rgba(255, 255, 255, 0.1);
}

	.person-contact__links a {
		display: flex;

		align-items: center;
		justify-content: space-between;

		gap: 15px;

		padding: 14px 0;

		border-bottom:
			1px solid rgba(255, 255, 255, 0.1);

		color: #ffffff;
		text-decoration: none;
	}

	.person-contact__links a:last-child {
		border-bottom: 0;
	}

	.person-contact__links a > span {
		color:
			rgba(255, 255, 255, 0.68);

		font-size: 12px;
		font-weight: 600;
	}

	.person-contact__links small {
		display: block;

		margin-top: 5px;

		color: #ffffff;

		font-size: 13px;
		font-weight: 500;
	}

	.person-contact__links svg {
		flex: 0 0 auto;

		width: 18px;
		height: 18px;

		fill: none;

		stroke: var(--color-yellow);
		stroke-width: 1.7;

		stroke-linecap: round;
		stroke-linejoin: round;

		transition: transform 180ms ease;
	}

	.person-contact__links a:hover svg {
		transform: translateX(5px);
	}

	.person-contact__pending {
		margin: 18px 0 0;

		color:
			rgba(255, 255, 255, 0.35);

		font-size: 12px;
		line-height: 1.5;
	}


	/* ==================================================
	   BOTTOM NAVIGATION
	   ================================================== */

	.footer__bottom {
		display: flex;

		align-items: center;
		justify-content: space-between;

		gap: 50px;

		margin-top: 46px;
		padding: 36px 0 30px;

		border-top:
			1px solid rgba(255, 255, 255, 0.11);
	}

	.footer__brand {
		display: flex;
		align-items: center;

		gap: 12px;

		color: #ffffff;
		text-decoration: none;
	}

	.footer__brand img {
		width: 50px;
		height: 50px;

		display: block;
		object-fit: contain;
	}

	.footer__brand div {
	display: flex;
	flex-direction: row;
	align-items: baseline;
	gap: 6px;
	line-height: 1;
	white-space: nowrap;
}

	.footer__brand strong {
		color: #ffffff;

		font-size: 17px;
		font-weight: 700;
	}

	.footer__brand span {
		margin-top: 0px;

		color:
			rgba(255, 255, 255, 0.7);

		font-size: 16px;
		font-weight: 600;
	}

	.footer__nav {
		display: flex;

		align-items: center;
		justify-content: flex-end;

		flex-wrap: wrap;

		gap: 8px 24px;
	}

	.footer__nav a {
		position: relative;

		color:
			rgba(255, 255, 255, 0.55);

		font-size: 12px;
		font-weight: 600;

		text-decoration: none;

		transition: color 180ms ease;
	}

	.footer__nav a:hover {
		color: #ffffff;
	}

	.footer__nav a:not(:last-child)::after {
		content: '·';

